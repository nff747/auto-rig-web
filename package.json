{
  "name": "auto-rig-web",
  "version": "0.1.0",
  "description": "Zero-click, browser-local character rigging using ONNX vision models and procedural Three.js skinning.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/worker/rigWorker.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit", "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nff747/auto-rig-web.git"
  },
  "keywords": [
    "threejs",
    "webgl",
    "onnx",
    "onnxruntime-web",
    "machine-learning",
    "character-rigging",
    "ik",
    "procedural-animation",
    "webgpu"
  ],
  "author": "iKi <nff747@users.noreply.github.com>",
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.18.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "jsdom": "^27.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
